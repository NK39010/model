# Local executable overrides for backend tools.
# Copy this file to .env and keep .env uncommitted.
# Docker users do not need to create this file: the image provides the tools.
#
# Recommended: link/copy IQ-TREE into the uv venv:
#   uv run python scripts/link_iqtree_to_venv.py
#
# On Windows, if IQ-TREE is missing, the script downloads the latest Windows
# release from https://github.com/iqtree/iqtree3/releases into .venv/tools/iqtree.
#
# When linked into .venv/bin or .venv/Scripts, leave IQTREE_BINARY unset.
#
# Use IQTREE_BINARY only when you need an explicit absolute path.
#
# macOS Homebrew, Apple Silicon:
# IQTREE_BINARY=/opt/homebrew/bin/iqtree3
#
# macOS Homebrew, Intel:
# IQTREE_BINARY=/usr/local/bin/iqtree3
#
# Windows, official ZIP or manual install:
# IQTREE_BINARY=C:\Tools\iqtree-3.1.2-Windows\bin\iqtree3.exe
#
# Windows, Conda/Mambaforge example:
# IQTREE_BINARY=C:\Users\YOUR_NAME\mambaforge\envs\bio\Library\bin\iqtree3.exe
#
# Linux/Homebrew/Conda on PATH can omit this variable entirely.
# IQTREE_BINARY=/opt/homebrew/bin/iqtree3

# R/ggtree visualization module.
# Leave unset when Rscript is already on PATH. Set RSCRIPT_BINARY when R is
# installed in a custom location.
#
# Required R packages:
#   Rscript scripts/install_r_packages.R
# Optional SVG output:
#   install.packages("svglite")
#
# macOS Homebrew:
# RSCRIPT_BINARY=/opt/homebrew/bin/Rscript
#
# Windows default R install example:
# RSCRIPT_BINARY=C:\Program Files\R\R-4.5.0\bin\Rscript.exe
